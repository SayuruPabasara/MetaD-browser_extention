{
  "manifest_version": 3,
  "name": "MetaD",
  "version": "0.1.0",
  "description": "Captures Courseweb download information for automatic file organization.",
  "permissions": [
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://courseweb.sliit.lk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
    "content_scripts": [
        {
            "matches": [
                "https://courseweb.sliit.lk/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}
